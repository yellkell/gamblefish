rules_version = '2';

/**
 * FISH & CHIPS: the Firestore behind gamblefish.web.app (a project shared with
 * the WINDOWS game: its leaderboard rule is below, unchanged).
 *
 * Everything here is written by the bank server (server/bank.mjs) with admin
 * credentials, which these rules do not bind:
 *
 *   bank/{uid}            credit (what Stripe has been paid for) and claimed
 *   bank/{uid}/receipts   one per checkout session, so a replayed webhook
 *                         credits nothing twice
 *   saves/{uid}           the account's game save
 *
 * A player may READ their own and nobody may write from a client, because a
 * wallet a client can write is a wallet a client can print.
 *
 * The one thing clients do write is the music team's soundtrack board, which
 * holds no money and opens only to the team key whose hash it names.
 */

service cloud.firestore {
  match /databases/{database}/documents {
    function mine(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /bank/{uid} {
      allow read: if mine(uid);
      allow write: if false;
      match /receipts/{receipt} {
        allow read: if mine(uid);
        allow write: if false;
      }
    }

    match /saves/{uid} {
      allow read: if mine(uid);
      allow write: if false;
    }

    /* ── the soundtrack board (public/soundtrack.html) ───────────────── */
    // The music team's board: soundtrack/<team key>/songs, each song's file in
    // its parts subcollection (≤ 1 MB a document). Anyone holding the team link
    // (…/soundtrack.html#<team key>) may read and change it, like a shared doc.
    // Only the key whose SHA-256 is below opens: the key itself is never in the
    // repo. A new key (to shut out an old link) is a new hash here.
    match /soundtrack/{room}/songs/{song} {
      function teamOpen() {
        return hashing.sha256(room).toHexString().lower() == 'b4ddc6b103766836d2e6b7791ec6f6f6e78eccd41262ae388d57009011e16f84';
      }
      function validSong() {
        let d = request.resource.data;
        return d.keys().hasOnly(['playlist', 'source', 'title', 'file', 'type', 'size', 'duration', 'parts', 'by', 'at', 'order', 'gamePath'])
            && d.playlist in ['day', 'night-wander', 'night-fish']
            && d.source in ['upload', 'game']
            && d.title is string && d.title.size() > 0 && d.title.size() <= 80
            && (!('by' in d) || (d.by is string && d.by.size() <= 40));
      }
      allow read, delete: if teamOpen();
      allow create, update: if teamOpen() && validSong();

      match /parts/{part} {
        allow read, delete: if teamOpen();
        allow create: if teamOpen()
                      && request.resource.data.keys().hasOnly(['n', 'bytes'])
                      && request.resource.data.n is int
                      && request.resource.data.bytes is bytes
                      && request.resource.data.bytes.size() <= 1000000;
        allow update: if false;
      }
    }

    /* ── the WINDOWS game's leaderboard ────────────────────────────────── */
    // The window-7b629 project is shared with another game (window-7b629.web.app).
    // Its rule is kept here exactly as it was in the console, because deploying
    // this file replaces the project's rules wholesale.
    match /leaderboard/{entry} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['name', 'windows', 'timestamp'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 20
                    && request.resource.data.windows is int
                    && request.resource.data.windows >= 0
                    && request.resource.data.timestamp is int;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
